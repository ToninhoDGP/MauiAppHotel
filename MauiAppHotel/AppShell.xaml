<?xml version="1.0" encoding="UTF-8" ?>
<Shell
    x:Class="MauiAppHotel.AppShell"
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    xmlns:local="clr-namespace:MauiAppHotel"
    xmlns:views="clr-namespace:MauiAppHotel.Views"
    Title="MauiAppHotel">

    <TabBar>
        <Tab Title="Hospedagem">
            <ShellContent
                Title="Reserva"
                ContentTemplate="{DataTemplate local:MainPage}"
                Route="MainPage" />
        </Tab>

        <Tab Title="Sobre">
            <ShellContent
                Title="Sobre"
                ContentTemplate="{DataTemplate views:Sobre}"
                Route="Sobre" />
        </Tab>
    </TabBar>

</Shell>